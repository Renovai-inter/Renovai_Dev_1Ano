<%@ page pageEncoding="UTF-8" %>
<style>
    /* ===== MENU LATERAL (v2) =====
       Fica fixo na tela: acompanha a rolagem da página.
       O .layout reserva o espaço dele com padding-left, então todas as páginas
       que incluem este arquivo só precisam ter <div class="layout"> envolvendo menu + conteúdo. */
    .layout {
        display: flex;
        align-items: flex-start;
        gap: 0;
        min-height: 100vh;
        padding: 0 0 0 240px;
    }

    /* Páginas que ainda usam estilo.css (sem padding lateral no conteúdo) */
    .layout > .conteudo { padding-left: 46px; padding-right: 48px; }

    .layout > .menu {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        z-index: 50;
        width: 240px;
        height: 100vh;
        max-height: none;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        padding: 28px 16px 24px;
        background: #618c66;
        color: #fff;
        border-radius: 0 24px 24px 0;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .layout > .menu .logo { margin: 0 0 28px 12px; display: block; }
    .layout > .menu .logo a { display: block; margin: 0; padding: 0; background: none; border-radius: 0; }
    .layout > .menu .logo a:hover { background: none; }
    .layout > .menu a.voltar-site { margin-top: auto; margin-bottom: 12px; }
    .layout > .menu a.voltar-site + .usuario { margin-top: 0; }
    .layout > .menu .logo img { display: block; width: 150px; max-width: 100%; height: auto; }

    .layout > .menu a {
        display: flex;
        align-items: center;
        gap: 14px;
        height: auto;
        margin: 0 0 8px;
        padding: 12px 16px;
        border-radius: 10px;
        color: #fff;
        font-size: 17px;
        font-weight: 400;
        line-height: 1.2;
        text-decoration: none;
        white-space: nowrap;
        transition: background .15s;
    }
    .layout > .menu a svg { width: 24px; height: 24px; flex-shrink: 0; }
    .layout > .menu a span { display: inline; }
    .layout > .menu .logo { justify-content: flex-start; }
    .layout > .menu .usuario div { display: block; }
    .layout > .menu a:hover { background: rgba(255, 255, 255, .15); }
    .layout > .menu a.ativo { background: #b3cca9; color: #2f4d33; font-weight: 500; }
    .layout > .menu a:focus-visible { outline: 3px solid #f0c24b; outline-offset: 2px; }

    .layout > .menu .usuario {
        margin-top: auto;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 8px 0;
        background: none;
        border: 0;
        border-radius: 0;
        color: #fff;
    }
    .layout > .menu .usuario-avatar {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #b3cca9;
        color: #2f4d33;
    }
    .layout > .menu .usuario-avatar svg { width: 22px; height: 22px; }
    .layout > .menu .usuario b { display: block; font-size: 15px; font-weight: 600; color: #fff; }
    .layout > .menu .usuario small { display: block; font-size: 12px; color: rgba(255, 255, 255, .85); }

    /* ===== RESPONSIVIDADE =====
       Em qualquer largura o conteúdo pode encolher (min-width: 0), então uma tabela larga
       rola dentro do próprio cartão em vez de esticar a página inteira. */
    .layout > main,
    .layout > .conteudo { min-width: 0; max-width: 100%; }

    /* Tablet e celular: o menu deixa de ser lateral e vira uma barra no topo,
       com os itens rolando para o lado quando não cabem. */
    @media (max-width: 820px) {
        .layout { flex-direction: column; align-items: stretch; padding-left: 0; }
        .layout > main,
        .layout > .conteudo { width: 100%; }
        .layout > .conteudo { padding-left: 16px; padding-right: 16px; }

        .layout > .menu {
            position: sticky;
            top: 0;
            bottom: auto;
            width: 100%;
            height: auto;
            flex-direction: row;
            align-items: center;
            gap: 4px;
            padding: 10px 12px;
            border-radius: 0;
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }
        .layout > .menu::-webkit-scrollbar { display: none; }
        .layout > .menu .logo { flex: 0 0 auto; margin: 0 12px 0 0; }
        .layout > .menu .logo img { width: 110px; }
        .layout > .menu a { flex: 0 0 auto; margin: 0; padding: 8px 12px; font-size: 14px; gap: 8px; }
        .layout > .menu a svg { width: 18px; height: 18px; }
        .layout > .menu .usuario { display: none; }

        /* Tabelas de listagem: as colunas não quebram o texto, a tabela rola para o lado */
        .tabela th, .tabela td,
        .coop-table th, .coop-table td,
        .painel table th, .painel table td { white-space: nowrap; }
        .painel { overflow-x: auto; }
        .coop-table { min-width: 560px; }
    }

    /* Celular */
    @media (max-width: 480px) {
        .layout > main,
        .layout > .conteudo { padding-left: 14px; padding-right: 14px; }
        .cartao, .pagina-v2 .cartao, .coop-card, .card, .painel-dash { padding: 18px 16px; border-radius: 16px; }
        .layout h1 { font-size: 1.7rem; }
        .pagina-v2 .topo h1, .coop-top h1, .topo h1 { font-size: 1.7rem; }
    }
</style>

<%!
    // Evita que um texto com < > " quebre a pagina
    private String esc(Object o) {
        if (o == null) return "";
        return o.toString().replace("&", "&amp;").replace("<", "&lt;")
                .replace(">", "&gt;").replace("\"", "&quot;");
    }

    // "JOÃO BATISTA" vira "João Batista" (o banco guarda os nomes em maiusculas)
    private String nomeBonito(String texto) {
        if (texto == null || texto.trim().isEmpty()) {
            return "";
        }
        StringBuilder sb = new StringBuilder();
        for (String palavra : texto.trim().toLowerCase().split("\\s+")) {
            boolean particula = palavra.equals("da") || palavra.equals("de") || palavra.equals("do")
                    || palavra.equals("das") || palavra.equals("dos") || palavra.equals("e");
            if (sb.length() > 0) {
                sb.append(' ');
            }
            sb.append(particula ? palavra : palavra.substring(0, 1).toUpperCase() + palavra.substring(1));
        }
        return sb.toString();
    }

    // Nome do item do menu que corresponde ao caminho da página (ex.: /coleta -> "coletas")
    private String itemDoCaminho(String caminho) {
        if (caminho == null) return "";
        if (caminho.startsWith("/dashboard") || caminho.equals("/index.jsp")) return "dashboard";
        if (caminho.startsWith("/cooperativa")) return "cooperativas";
        if (caminho.startsWith("/cooperado")) return "cooperados";
        if (caminho.startsWith("/coleta") || caminho.contains("coleta")) return "coletas";
        if (caminho.startsWith("/material") || caminho.startsWith("/materiais")) return "materiais";
        if (caminho.startsWith("/rota")) return "rotas";
        if (caminho.startsWith("/negociacao")) return "negociacoes";
        return "";
    }
%>
<%
    // Item do menu que fica em destaque. A página pode definir o seu antes de incluir o menu:
    //   request.setAttribute("menuAtivo", "negociacoes");
    // Sem isso, o menu descobre sozinho pelo endereço que o usuário acessou.
    String menuItemAtivo = (String) request.getAttribute("menuAtivo");
    if (menuItemAtivo == null || menuItemAtivo.isEmpty()) {
        String caminhoMenu = (String) request.getAttribute("jakarta.servlet.forward.servlet_path");
        if (caminhoMenu == null) caminhoMenu = request.getServletPath();
        menuItemAtivo = itemDoCaminho(caminhoMenu);
    }
    String raizMenu = request.getContextPath();   // ex.: /Renovai_Dev_1Ano_war_exploded
    String nomeMenu = (String) session.getAttribute("nomeUsuario");
    if (nomeMenu == null || nomeMenu.isBlank()) nomeMenu = "Usuário";
%>
<nav class="menu" aria-label="Menu principal">

    <div class="logo">
        <a href="<%= raizMenu %>/" title="Voltar ao site">
            <img src="<%= raizMenu %>/img/logo-renovai.png" alt="Renovaí - Área Administrativa (voltar ao site)">
        </a>
    </div>

    <a href="<%= raizMenu %>/dashboard"<%= "dashboard".equals(menuItemAtivo) ? " class=\"ativo\" aria-current=\"page\"" : "" %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/>
            <rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>
        </svg>
        <span>Dashboard</span>
    </a>

    <a href="<%= raizMenu %>/cooperativa"<%= "cooperativas".equals(menuItemAtivo) ? " class=\"ativo\" aria-current=\"page\"" : "" %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/>
            <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/>
            <path d="M10 14h4"/><path d="M10 18h4"/>
        </svg>
        <span>Cooperativas</span>
    </a>

    <a href="<%= raizMenu %>/cooperado"<%= "cooperados".equals(menuItemAtivo) ? " class=\"ativo\" aria-current=\"page\"" : "" %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span>Cooperados</span>
    </a>

    <a href="<%= raizMenu %>/coleta"<%= "coletas".equals(menuItemAtivo) ? " class=\"ativo\" aria-current=\"page\"" : "" %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/>
            <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/>
            <circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>
        </svg>
        <span>Coletas</span>
    </a>

    <a href="<%= raizMenu %>/material"<%= "materiais".equals(menuItemAtivo) ? " class=\"ativo\" aria-current=\"page\"" : "" %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m7.5 4.27 9 5.15"/>
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
            <path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>
        </svg>
        <span>Materiais</span>
    </a>

    <a href="<%= raizMenu %>/rota"<%= "rotas".equals(menuItemAtivo) ? " class=\"ativo\" aria-current=\"page\"" : "" %>>
        <svg viewBox="0 0 100 100" fill="currentColor" stroke="none" aria-hidden="true">
            <path fill="currentColor" d="M21 32C9.459 32 0 41.43 0 52.94c0 4.46 1.424 8.605 3.835 12.012l14.603 25.244c2.045 2.672 3.405 2.165 5.106-.14l16.106-27.41c.325-.59.58-1.216.803-1.856A20.7 20.7 0 0 0 42 52.94C42 41.43 32.544 32 21 32m0 9.812c6.216 0 11.16 4.931 11.16 11.129S27.215 64.068 21 64.068S9.84 59.138 9.84 52.941S14.786 41.812 21 41.812M87.75 0C81.018 0 75.5 5.501 75.5 12.216c0 2.601.83 5.019 2.237 7.006l8.519 14.726c1.193 1.558 1.986 1.262 2.978-.082l9.395-15.99c.19-.343.339-.708.468-1.082a12 12 0 0 0 .903-4.578C100 5.5 94.484 0 87.75 0m0 5.724c3.626 0 6.51 2.876 6.51 6.492s-2.884 6.49-6.51 6.49s-6.51-2.875-6.51-6.49s2.885-6.492 6.51-6.492"/><path fill="currentColor" fill-rule="evenodd" d="M88.209 37.412c-2.247.05-4.5.145-6.757.312l.348 5.532a126 126 0 0 1 6.513-.303zm-11.975.82c-3.47.431-6.97 1.045-10.43 2.032l1.303 5.361c3.144-.896 6.402-1.475 9.711-1.886zM60.623 42.12a24.5 24.5 0 0 0-3.004 1.583l-.004.005l-.006.002c-1.375.866-2.824 1.965-4.007 3.562c-.857 1.157-1.558 2.62-1.722 4.35l5.095.565c.038-.406.246-.942.62-1.446h.002v-.002c.603-.816 1.507-1.557 2.582-2.235l.004-.002a20 20 0 0 1 2.388-1.256zM58 54.655l-3.303 4.235c.783.716 1.604 1.266 2.397 1.726l.01.005l.01.006c2.632 1.497 5.346 2.342 7.862 3.144l1.446-5.318c-2.515-.802-4.886-1.576-6.918-2.73c-.582-.338-1.092-.691-1.504-1.068m13.335 5.294l-1.412 5.327l.668.208l.82.262c2.714.883 5.314 1.826 7.638 3.131l2.358-4.92c-2.81-1.579-5.727-2.611-8.538-3.525l-.008-.002l-.842-.269zm14.867 7.7l-3.623 3.92c.856.927 1.497 2.042 1.809 3.194l.002.006l.002.009c.372 1.345.373 2.927.082 4.525l5.024 1.072c.41-2.256.476-4.733-.198-7.178c-.587-2.162-1.707-4.04-3.098-5.548M82.72 82.643a12 12 0 0 1-1.826 1.572h-.002c-1.8 1.266-3.888 2.22-6.106 3.04l1.654 5.244c2.426-.897 4.917-1.997 7.245-3.635l.006-.005l.003-.002a17 17 0 0 0 2.639-2.287zm-12.64 6.089c-3.213.864-6.497 1.522-9.821 2.08l.784 5.479c3.421-.575 6.856-1.262 10.27-2.18zm-14.822 2.836c-3.346.457-6.71.83-10.084 1.148l.442 5.522c3.426-.322 6.858-.701 10.285-1.17zm-15.155 1.583c-3.381.268-6.77.486-10.162.67l.256 5.536c3.425-.185 6.853-.406 10.28-.678zm-15.259.92c-2.033.095-4.071.173-6.114.245l.168 5.541a560 560 0 0 0 6.166-.246z" color="currentColor"/>
        </svg>
        <span>Rotas</span>
    </a>

    <a href="<%= raizMenu %>/negociacao"<%= "negociacoes".equals(menuItemAtivo) ? " class=\"ativo\" aria-current=\"page\"" : "" %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m11 17 2 2a1 1 0 1 0 3-3"/>
            <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/>
            <path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/>
        </svg>
        <span>Negociações</span>
    </a>

    <a href="<%= raizMenu %>/" class="voltar-site">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
        </svg>
        <span>Voltar ao site</span>
    </a>

    <div class="usuario">
        <span class="usuario-avatar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
        </span>
        <div>
            <b><%= esc(nomeMenu) %></b>
            <small>Administrador</small>
        </div>
    </div>
</nav>
 