<%@ page pageEncoding="UTF-8" %>
<style>
    .menu {
        position: sticky;
        top: 0;
        width: 240px;
        height: 100vh;
        align-self: flex-start;
        flex-shrink: 0;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .menu .usuario { margin-top: auto; }

    .menu a {
        font-size: 17px;
        gap: 12px;
        padding: 11px 14px;
        white-space: nowrap;
    }
    .menu a svg { width: 24px; height: 24px; }

    .menu .logo-texto b     { font-size: 24px; }
    .menu .logo-texto small { font-size: 12px; }
    .menu .usuario b        { font-size: 15px; }
    .menu .usuario small    { font-size: 12px; }
    .menu .usuario-avatar svg { width: 22px; height: 22px; }
    .menu a {
        display: flex !important;
        align-items: center !important;
        gap: 14px !important;               /* espaço entre ícone e texto */
        padding: 12px 16px !important;      /* espaço interno do item */
        margin: 0 0 8px 0 !important;       /* espaço entre os itens */
        letter-spacing: normal !important;
        line-height: 1.2 !important;
    }

    .menu a span {
        margin: 0 !important;
        padding: 0 !important;
    }
</style>

<%!
    // Evita que um texto com < > " quebre a pagina
    private String esc(Object o) {
        if (o == null) return "";
        return o.toString().replace("&", "&amp;").replace("<", "&lt;")
                .replace(">", "&gt;").replace("\"", "&quot;");
    }
%>
<%
    // Item do menu que fica em destaque. Cada tela define o seu antes de incluir o menu:
    //   request.setAttribute("menuAtivo", "negociacoes");   ou   "cooperados"
    String menuItemAtivo = (String) request.getAttribute("menuAtivo");
    if (menuItemAtivo == null) menuItemAtivo = "";
    String raizMenu = request.getContextPath();   // ex.: /Renovai_Dev_1Ano_war_exploded
%>
<div class="menu">

    <div class="logo">
        <img src="${pageContext.request.contextPath}/img/logo-renovai.png" alt="Renovai - Área Administrativa">
    </div>

    <a href="<%= raizMenu %>/dashboard">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/>
            <rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>
        </svg>
        <span>Dashboard</span>
    </a>

    <a href="<%= raizMenu %>/cooperativa">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/>
            <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/>
            <path d="M10 14h4"/><path d="M10 18h4"/>
        </svg>
        <span>Cooperativas</span>
    </a>

    <a href="<%= raizMenu %>/cooperado"<%= "cooperados".equals(menuItemAtivo) ? " class=\"ativo\"" : "" %>>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span>Cooperados</span>
    </a>

    <a href="<%= raizMenu %>/coleta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/>
            <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/>
            <circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>
        </svg>
        <span>Coletas</span>
    </a>

    <a href="<%= raizMenu %>/material">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m7.5 4.27 9 5.15"/>
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
            <path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>
        </svg>
        <span>Materiais</span>
    </a>

    <a href="<%= raizMenu %>/negociacao"<%= "negociacoes".equals(menuItemAtivo) ? " class=\"ativo\"" : "" %>>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m11 17 2 2a1 1 0 1 0 3-3"/>
            <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/>
            <path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/>
        </svg>
        <span>Negociações</span>
    </a>

    <div class="usuario">
        <span class="usuario-avatar">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
        </span>
        <div>
            <b>Nome usuário</b>
            <small>Administrador</small>
        </div>
    </div>
</div>
