<%-- Cartoes da cooperativa e da recicladora (telas Ver e Editar).
     Usa a variavel "negociacao" da pagina que inclui este arquivo. --%>
<div class="neg-partes">
    <div class="neg-parte neg-parte-coop">
        <div class="neg-parte-rotulo">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/>
                <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>
            </svg>
            COOPERATIVA
        </div>
        <strong><%= esc(negociacao.getNomeCooperativa()) %></strong>
        <span><%= esc(negociacao.getCidadeCooperativa()) %>/<%= esc(negociacao.getEstadoCooperativa()) %> &bull; <%= esc(negociacao.getCnpjCooperativa()) %></span>
    </div>
    <div class="neg-parte neg-parte-reci">
        <div class="neg-parte-rotulo">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/>
            </svg>
            RECICLADORA
        </div>
        <strong><%= esc(negociacao.getNomeEmpresa()) %></strong>
        <span><%= esc(negociacao.getCidadeEmpresa()) %>/<%= esc(negociacao.getEstadoEmpresa()) %> &bull; <%= esc(negociacao.getCnpjEmpresa()) %></span>
    </div>
</div>

