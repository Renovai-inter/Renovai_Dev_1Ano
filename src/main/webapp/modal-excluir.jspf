<%@ page pageEncoding="UTF-8" %>
<%-- Precisa das variaveis "c" (Cooperado) e "totalColetas" definidas na pagina que inclui,
     e da funcao rotulo() da pagina (so formata o texto do cargo) --%>
<div class="modal-fundo" id="excluir">
    <form class="modal" method="post" action="cooperado">
        <input type="hidden" name="id" value="<%= c.getIdCooperado() %>">

        <a href="#" class="modal-fechar" aria-label="Fechar">&times;</a>

        <h3>Excluir cooperado</h3>
        <p class="sub">Revise o impacto antes de confirmar a ação sobre "<%= esc(c.getNomeCompleto()) %>".</p>

        <p class="mini">Registros relacionados afetados</p>
        <div class="registros">
            <div><span>Cooperativa</span><b><%= esc(c.getNomeCooperativa()) %></b></div>
            <div><span>Cargo</span><b><%= (c.getCargo() == null || c.getCargo().isEmpty()) ? "Cooperado" : esc(rotulo(c.getCargo())) %></b></div>
            <div><span>Conta de acesso removido</span><b><%= esc(c.getNomeUsuario()) %></b></div>
            <div><span>Coletas com esse responsável</span><b><%= totalColetas %></b></div>
        </div>

        <label class="opcao">
            <input type="radio" name="acao" value="inativar" checked>
            <span>
                <b>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/>
                    </svg>
                    Alterar status para inativo
                </b>
                Recomendado: mantém o histórico de coletas e a rastreabilidade das ações.
            </span>
        </label>
        <label class="opcao perigo">
            <input type="radio" name="acao" value="excluir">
            <span>
                <b>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                        <line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/>
                    </svg>
                    Excluir permanentemente
                </b>
                Ação irreversível, remove todo o histórico.
            </span>
        </label>

        <div class="rodape">
            <a href="#" class="botao botao-form botao-cancelar">Cancelar</a>
            <button type="submit" id="botaoConfirmarExcluir" class="botao botao-form botao-escuro">Inativar</button>
        </div>
    </form>
</div>
<script>
    // O botao principal acompanha a opcao escolhida: "Inativar" (verde) ou "Excluir" (vinho)
    (function () {
        var modal = document.getElementById('excluir');
        var botao = document.getElementById('botaoConfirmarExcluir');
        var radios = modal.querySelectorAll('input[name="acao"]');

        function atualizar() {
            var excluir = modal.querySelector('input[name="acao"][value="excluir"]').checked;
            botao.textContent = excluir ? 'Excluir' : 'Inativar';
            botao.className = excluir ? 'botao botao-form botao-perigo' : 'botao botao-form botao-escuro';
        }

        radios.forEach(function (r) { r.addEventListener('change', atualizar); });
        atualizar();
    })();
</script>
